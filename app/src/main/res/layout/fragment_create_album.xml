<?xml version="1.0" encoding="utf-8"?>
<!--
    HU07 - Formulario de creación de álbum.
    Los campos obligatorios se marcan con "*" y cada TextInputLayout muestra su error debajo del campo.
    La vista previa de la portada (layout_cover_preview) y su error (tv_cover_preview_error) empiezan ocultos.
    Los botones quedan fuera del área desplazable para que "Crear álbum" siempre esté a la vista.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_create_album"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/action_back"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/album_form_title"
            app:titleTextColor="?attr/colorOnSurface" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_create_album"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_album_name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/album_form_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_album_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_album_cover"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/album_form_cover_hint"
                app:placeholderText="@string/album_form_cover_placeholder">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_album_cover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Vista previa de la portada: se muestra cuando la URL es válida -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_cover_preview"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="@dimen/album_form_cover_preview_size"
                android:layout_height="@dimen/album_form_cover_preview_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/card_corner_radius"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iv_cover_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/album_form_cover_preview_description"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/ic_album_placeholder" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_cover_preview_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/album_form_cover_preview_error"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <!-- La fecha solo se elige en el selector: el campo no abre el teclado -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_album_release_date"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/album_form_release_date_hint"
                app:endIconContentDescription="@string/album_form_release_date_pick"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_album_release_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_album_description"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/album_form_description_hint"
                app:counterEnabled="true"
                app:counterMaxLength="@integer/album_description_max_length">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_album_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="@integer/album_description_max_length"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Las opciones de los desplegables las carga la vista desde AlbumFormValidator -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_album_genre"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/album_form_genre_hint"
                app:endIconContentDescription="@string/album_form_genre_pick">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actv_album_genre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_album_record_label"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/album_form_record_label_hint"
                app:endIconContentDescription="@string/album_form_record_label_pick">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actv_album_record_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- "Crear álbum" cambia a "Guardando…" y se deshabilita mientras se guarda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_album_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_album_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:text="@string/album_form_submit" />
    </LinearLayout>

</LinearLayout>
