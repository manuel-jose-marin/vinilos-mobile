<?xml version="1.0" encoding="utf-8"?>
<!--
  HU08 - Hoja inferior "Agregar track", que se abre desde el detalle del álbum sin salir de él.
  Muestra a qué álbum se agrega el track, los campos obligatorios con su texto de ayuda y los botones
  "Cancelar" y "Agregar". El contenido se puede desplazar para que, con el teclado abierto, los botones
  sigan a la vista (la hoja debe mostrarse con adjustResize).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_add_track"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/screen_margin">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/drag_handle_add_track"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_add_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_track_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_add_track_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Al álbum Buscando América" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_track_name"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/add_track_name_hint"
            app:counterEnabled="true"
            app:counterMaxLength="@integer/track_name_max_length"
            app:helperText="@string/add_track_name_helper"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_track_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_track_duration"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/add_track_duration_hint"
            app:helperText="@string/add_track_duration_helper"
            app:helperTextEnabled="true"
            app:placeholderText="@string/add_track_duration_placeholder">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_track_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789:"
                android:imeOptions="actionDone"
                android:inputType="time"
                android:maxLength="5"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botones al final, alineados a la derecha: "Agregar" se deshabilita mientras se guarda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_track_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_track_submit"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/add_track_submit" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
