<?xml version="1.0" encoding="utf-8"?>
<!-- HU04 - Álbum del carrusel del detalle de artista: portada, nombre, año y sello -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_artist_album"
    android:layout_width="@dimen/artist_album_width"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/grid_padding">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="@dimen/artist_album_cover_height"
        android:duplicateParentState="true"
        app:cardCornerRadius="@dimen/card_corner_radius">

        <ImageView
            android:id="@+id/iv_artist_album_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/album_cover_description"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_album_placeholder" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_artist_album_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurface"
        tools:text="A Night at the Opera" />

    <TextView
        android:id="@+id/tv_artist_album_year_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="1975 · EMI" />

</LinearLayout>
