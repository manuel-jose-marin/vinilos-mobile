<?xml version="1.0" encoding="utf-8"?>
<!-- Grafo de navegación principal. Los destinos de primer nivel son los de la barra inferior (mismos ids que menu_bottom_nav). -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/albumListFragment">

    <fragment
        android:id="@+id/albumListFragment"
        android:name="co.edu.uniandes.vinilos.ui.AlbumListFragment"
        android:label="@string/nav_albums"
        tools:layout="@layout/fragment_album_list">

        <action
            android:id="@+id/action_albumListFragment_to_albumDetailFragment"
            app:destination="@id/albumDetailFragment" />
    </fragment>

    <!-- Detalle de un álbum (HU02): destino de segundo nivel, sin barra inferior. -->
    <fragment
        android:id="@+id/albumDetailFragment"
        android:name="co.edu.uniandes.vinilos.ui.AlbumDetailFragment"
        android:label="@string/album_detail_title"
        tools:layout="@layout/fragment_album_detail">

        <argument
            android:name="albumId"
            app:argType="integer" />

        <argument
            android:name="albumName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/artistListFragment"
        android:name="co.edu.uniandes.vinilos.ui.ArtistListFragment"
        android:label="@string/nav_artists"
        tools:layout="@layout/fragment_artist_list" />

    <fragment
        android:id="@+id/collectorListFragment"
        android:name="co.edu.uniandes.vinilos.ui.CollectorListFragment"
        android:label="@string/nav_collectors"
        tools:layout="@layout/fragment_collector_list" />

</navigation>
